# Copy to .env.local for local development. On Railway, set these as service variables.
# NEVER commit the real values.

# Neon connection string — Neon console > ISKCON-CND-DB > Connect > pooled connection
# Certificate verification for the database connection. Off by default, which
# means the connection is encrypted but the certificate is not checked.
# Turn on with PGSSL_VERIFY=true — on the staff app first, confirm sign-in
# still works, then here. A wrong TLS setting fails closed.
PGSSL_VERIFY=false

DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Signs the session cookie. MINIMUM 24 CHARACTERS — the app refuses to start a
# session with anything shorter, because a guessable value lets someone forge a
# super-admin session. Generate with:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-24-characters

# Optional: session lifetime in hours (default 12)
SESSION_HOURS=12
