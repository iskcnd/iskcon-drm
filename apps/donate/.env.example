# ISKCON Chennai — apps/donate
# Copy to .env.local for development. On Railway, set these as service variables.
# NEVER commit real values. Live gateway keys go straight into Railway env — not chat, not git.

# Certificate verification for the database connection. Off by default, which
# means the connection is encrypted but the certificate is not checked.
# Turn on with PGSSL_VERIFY=true — on the staff app first, confirm sign-in
# still works, then here. A wrong TLS setting fails closed.
PGSSL_VERIFY=false

DATABASE_URL=postgres://user:pass@host/db          # ISKCON-CND-DB pooled connection string
PUBLIC_BASE_URL=https://donate.iskconchennai.org   # used for gateway return URLs

# --- Gateways ---
# Which gateways to offer, and in what order. The first is pre-selected; the
# donor can pick any of them, and can switch after a failure.
# Omit one to hide it entirely, e.g. GATEWAYS_ENABLED=razorpay,payu
# A gateway whose KEY/SALT below are blank is dropped automatically — the page
# never shows a button that cannot work.
GATEWAYS_ENABLED=payu,razorpay,easebuzz

MOCK_GATEWAYS=true            # true = simulated payments, no gateway calls. Set false in production.
PAYU_ENV=test                 # test | production
PAYU_KEY=
PAYU_SALT=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
EASEBUZZ_ENV=test             # test | production
EASEBUZZ_KEY=
EASEBUZZ_SALT=

# --- Zoho Flow webhook (D30) ---
# Full incoming-webhook URL INCLUDING the zapikey query parameter.
ZOHO_WEBHOOK_URL=
# Zoho Creator record ids used when a category has no mapping of its own:
ZOHO_PAYMENT_TYPE_ID=251028000000612003
ZOHO_DEFAULT_SEVA_TYPE_ID=251028000000067075
ZOHO_DEFAULT_CATEGORY_ID=251028000000014003

# --- Receipt delivery (WhatsApp + email) ---
# Credentials only. WHAT gets sent, to whom, and whether it is switched on
# lives in the notification_config table, edited at DRM -> Donations -> Messages.
# There is deliberately no env flag for enabling messages: two switches in two
# places is how you end up sending nothing and not knowing why.

GALLABOX_API_KEY=
GALLABOX_API_SECRET=
GALLABOX_CHANNEL_ID=          # fallback when the pasted payload has none
# GALLABOX_API_URL=https://server.gallabox.com/devapi/messages/whatsapp

RESEND_API_KEY=
EMAIL_FROM=ISKCON Chennai <info@iskconchennai.org>

# --- Internal ---
# All three of the secrets below must be long random strings. Generate each
# separately with:  openssl rand -base64 32
CRON_KEY=            # required by POST /api/internal/outbox
ADMIN_API_KEY=       # required by /api/admin/* until DRM auth takes over
RECEIPT_SECRET=      # signs receipt download links. REQUIRED — the app refuses to
                     # issue a receipt without it. Keep it separate from CRON_KEY so
                     # rotating the cron key doesn't break every receipt link already
                     # sent to devotees.
PUBLIC_ACTOR_ID=     # optional: app_user uuid recorded by audit triggers for public writes
